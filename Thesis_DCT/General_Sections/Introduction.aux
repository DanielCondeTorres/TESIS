\newlabel{sub@fig:AMP_alpha}{{a}{39}{$\alpha $-helical: pleurocidin}{figure.caption.2}{}}
\newlabel{fig:AMP_beta}{{1.2b}{39}{$\beta $-sheet: thanatin}{figure.caption.2}{}}
\newlabel{sub@fig:AMP_beta}{{b}{39}{$\beta $-sheet: thanatin}{figure.caption.2}{}}
\newlabel{fig:AMP_other}{{1.2c}{39}{Others: indolicidin}{figure.caption.2}{}}
\newlabel{sub@fig:AMP_other}{{c}{39}{Others: indolicidin}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Structure of antimicrobial peptides. AMPs are typically present four main types of structure: (a) $\alpha $-helical, pleurocidin [PDB ID: 1Z64]~\blx@tocontentsinit {0}\cite {1z64}, (b) $\beta $-sheet, thanatin [PDB ID: 9ILX]\blx@tocontentsinit {0}\cite {9ILX}, (c) others, indolicidin [PDB ID: 1G89]\blx@tocontentsinit {0}\cite {1g89}. Structures were obtained from the RCSB Protein Data Bank\blx@tocontentsinit {0}\cite {PDB} and visualized using VMD (Visual Molecular Dynamics)\blx@tocontentsinit {0}\cite {VMD} colored by residue type: apolar/hydrophobic (white), cationic (blue), and polar neutral (green).}}{39}{figure.caption.2}\protected@file@percent }
\newlabel{fig:AMPClass}{{1.2}{39}{Structure of antimicrobial peptides. AMPs are typically present four main types of structure: (a) $\alpha $-helical, pleurocidin [PDB ID: 1Z64]~\cite {1z64}, (b) $\beta $-sheet, thanatin [PDB ID: 9ILX]\cite {9ILX}, (c) others, indolicidin [PDB ID: 1G89]\cite {1g89}. Structures were obtained from the RCSB Protein Data Bank\cite {PDB} and visualized using VMD (Visual Molecular Dynamics)\cite {VMD} colored by residue type: apolar/hydrophobic (white), cationic (blue), and polar neutral (green)}{figure.caption.2}{}}
