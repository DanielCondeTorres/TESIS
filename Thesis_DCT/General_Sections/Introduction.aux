\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Structure of antimicrobial peptides. AMPs are typically present four main types of structure: (a) $\alpha $-helical, pleurocidin [PDB ID: 1Z64]\blx@tocontentsinit {0}\cite {1z64}, (b) $\beta $-sheet, thanatin [PDB ID: 9ILX]\blx@tocontentsinit {0}\cite {9ILX}, (c) others, indolicidin [PDB ID: 1G89]\blx@tocontentsinit {0}\cite {1g89}. Structures were obtained from the RCSB Protein Data Bank\blx@tocontentsinit {0}\cite {PDB} and visualized using VMD (Visual Molecular Dynamics)\blx@tocontentsinit {0}\cite {VMD} colored by residue type: apolar/hydrophobic (white), cationic (blue), and polar neutral (green).}}{31}{figure.caption.2}\protected@file@percent }
\newlabel{fig:AMPClass}{{1.2}{31}{Structure of antimicrobial peptides. AMPs are typically present four main types of structure: (a) $\alpha $-helical, pleurocidin [PDB ID: 1Z64]\cite {1z64}, (b) $\beta $-sheet, thanatin [PDB ID: 9ILX]\cite {9ILX}, (c) others, indolicidin [PDB ID: 1G89]\cite {1g89}. Structures were obtained from the RCSB Protein Data Bank\cite {PDB} and visualized using VMD (Visual Molecular Dynamics)\cite {VMD} colored by residue type: apolar/hydrophobic (white), cationic (blue), and polar neutral (green)}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1.4}Mechanisms of Membrane Disruption}{31}{section.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Structural diversity of AMPs and their membrane-disrupting mechanisms. (A) AMPs adopt diverse structural motifs, including $\alpha $-helices (magainin), extended structures (indolicidin), $\beta $-sheets (human defensin), and mixed conformations (protegrin-1), which influence their mode of action. (B) AMPs interact with bacterial membranes through various mechanisms, including membrane adsorption, pore formation (barrel stave, toroidal pore), the carpet model, electroporation, lipid clustering, and non-lytic depolarization. Reprinted from \textit  {Advances in Colloid and Interface Science}, Vol 350, Paula Antelo-Riveiro, Rebeca Garcia-Fandino, Ángel Piñeiro, ``Antimicrobial peptides at (lipid) interfaces: Insights from monolayer models'', 103775,\blx@tocontentsinit {0}\cite {paper_paula} Copyright (2026). This is an open access article under the CC BY 4.0 license (\url  {https://creativecommons.org/licenses/by/4.0/}).}}{32}{figure.caption.3}\protected@file@percent }
\newlabel{fig:AMPMOA}{{1.3}{32}{Structural diversity of AMPs and their membrane-disrupting mechanisms. (A) AMPs adopt diverse structural motifs, including $\alpha $-helices (magainin), extended structures (indolicidin), $\beta $-sheets (human defensin), and mixed conformations (protegrin-1), which influence their mode of action. (B) AMPs interact with bacterial membranes through various mechanisms, including membrane adsorption, pore formation (barrel stave, toroidal pore), the carpet model, electroporation, lipid clustering, and non-lytic depolarization. Reprinted from \textit {Advances in Colloid and Interface Science}, Vol 350, Paula Antelo-Riveiro, Rebeca Garcia-Fandino, Ángel Piñeiro, ``Antimicrobial peptides at (lipid) interfaces: Insights from monolayer models'', 103775,\cite {paper_paula} Copyright (2026). This is an open access article under the CC BY 4.0 license (\url {https://creativecommons.org/licenses/by/4.0/})}{figure.caption.3}{}}
