\newlabel{eq:angle}{{3.12}{53}{The Force Field}{equation.3.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Schematic representation of the bonded interactions included in the bonded term of the potential function. \textbf  {A} depicts the bond stretching, \textbf  {B} angle bending, \textbf  {C} the torsion of a proper dihedral and \textbf  {D} the bending of an improper dihedral}}{54}{figure.caption.6}\protected@file@percent }
\newlabel{fig:FF_bonded}{{3.3}{54}{Schematic representation of the bonded interactions included in the bonded term of the potential function. \textbf {A} depicts the bond stretching, \textbf {B} angle bending, \textbf {C} the torsion of a proper dihedral and \textbf {D} the bending of an improper dihedral}{figure.caption.6}{}}
