\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Representation of PCA applied to a 2D dataset with correlated features. The colored arrows represent the principal components: the red arrow indicates the direction of maximum variance in the data (PC1), while the blue is orthogonal to it and captures the remaining variance (PC2). This illustrates how PCA identifies the most informative directions for dimensionality reduction. The graph was generated with Matplotlib using synthetic data in arbitrary units.}}{53}{figure.caption.12}\protected@file@percent }
\newlabel{fig:PCA}{{3.7}{53}{Representation of PCA applied to a 2D dataset with correlated features. The colored arrows represent the principal components: the red arrow indicates the direction of maximum variance in the data (PC1), while the blue is orthogonal to it and captures the remaining variance (PC2). This illustrates how PCA identifies the most informative directions for dimensionality reduction. The graph was generated with Matplotlib using synthetic data in arbitrary units}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.2.1.2}OPTICS clusterization}{54}{subsubsection.3.2.1.2}\protected@file@percent }
