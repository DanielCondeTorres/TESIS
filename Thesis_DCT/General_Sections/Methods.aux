\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces OPTICS clustering applied to synthetic data. Top left shows the raw 2D point distribution; top right overlays the OPTICS spanning tree, with each point colored by its assigned cluster; bottom displays the reachability plot in OPTICS order, where valleys correspond to dense clusters and peaks indicate transitions between clusters. Graphs were generated with Matplotlib using synthetic data in arbitrary units.}}{55}{figure.caption.13}\protected@file@percent }
\newlabel{fig:Optics}{{3.8}{55}{OPTICS clustering applied to synthetic data. Top left shows the raw 2D point distribution; top right overlays the OPTICS spanning tree, with each point colored by its assigned cluster; bottom displays the reachability plot in OPTICS order, where valleys correspond to dense clusters and peaks indicate transitions between clusters. Graphs were generated with Matplotlib using synthetic data in arbitrary units}{figure.caption.13}{}}
