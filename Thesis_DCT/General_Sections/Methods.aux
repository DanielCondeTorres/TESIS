\@writefile{toc}{\contentsline {section}{\numberline {3.1}Molecular Dynamics}{41}{section.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.1}The Physics Behind Molecular Dynamics}{41}{subsection.3.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces General workflow for an MD simulation. This scheme summarizes the key steps in a MD simulation. First, the user provides an initial state for the system, selects the force field, and defines the simulation conditions. The force field is used to determine the forces acting on each particle allowing to define the future positions and velocities. Next, corrections are applied based on the simulation conditions to match the defined temperature and/or pressure of the system. This process is iteratively repeated until matching a convergence criteria or reach the maximum number of steps.}}{42}{figure.caption.6}\protected@file@percent }
\newlabel{fig:MDFlow}{{3.1}{42}{General workflow for an MD simulation. This scheme summarizes the key steps in a MD simulation. First, the user provides an initial state for the system, selects the force field, and defines the simulation conditions. The force field is used to determine the forces acting on each particle allowing to define the future positions and velocities. Next, corrections are applied based on the simulation conditions to match the defined temperature and/or pressure of the system. This process is iteratively repeated until matching a convergence criteria or reach the maximum number of steps}{figure.caption.6}{}}
\newlabel{NG}{{3.1}{42}{The Physics Behind Molecular Dynamics}{equation.3.1}{}}
\newlabel{N2L}{{3.2}{43}{The Physics Behind Molecular Dynamics}{equation.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Scheme of the Leap-Frog integration method. Both positions and velocities are integrated after a time step \(\Delta t\), but with a delay of \(\Delta t/2\) resembling two frogs that jump one after the other. The figure was generated using Matplotlib.}}{43}{figure.caption.7}\protected@file@percent }
\newlabel{fig:LeapFrog}{{3.2}{43}{Scheme of the Leap-Frog integration method. Both positions and velocities are integrated after a time step \(\Delta t\), but with a delay of \(\Delta t/2\) resembling two frogs that jump one after the other. The figure was generated using Matplotlib}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Scheme depicting the effect of periodic boundary conditions. The image shows how a particle that at an instant \(t\) is displaced outside the original simulation space (black solid line), re-enters into the box from its periodic image at a time \(t + \Delta t\). The number of particles in the simulation cell and in all the periodic images are kept constant. Image generated with Matplotlib.}}{44}{figure.caption.8}\protected@file@percent }
\newlabel{fig:PBCs}{{3.3}{44}{Scheme depicting the effect of periodic boundary conditions. The image shows how a particle that at an instant \(t\) is displaced outside the original simulation space (black solid line), re-enters into the box from its periodic image at a time \(t + \Delta t\). The number of particles in the simulation cell and in all the periodic images are kept constant. Image generated with Matplotlib}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.2}The Force Field}{45}{subsection.3.1.2}\protected@file@percent }
\newlabel{eq:angle}{{3.7}{45}{The Force Field}{equation.3.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Schematic representation of the bonded interactions included in the bonded term of the potential function. \textbf  {A} depicts the bond stretching, \textbf  {B} angle bending, \textbf  {C} the torsion of a proper dihedral and \textbf  {D} the bending of an improper dihedral}}{46}{figure.caption.9}\protected@file@percent }
\newlabel{fig:FF_bonded}{{3.4}{46}{Schematic representation of the bonded interactions included in the bonded term of the potential function. \textbf {A} depicts the bond stretching, \textbf {B} angle bending, \textbf {C} the torsion of a proper dihedral and \textbf {D} the bending of an improper dihedral}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.2.1}The Resolution of the Force Fields}{48}{subsubsection.3.1.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Representation of the 3D structure of a CP with sequence \underline  {L}L\underline  {L}L\underline  {L}L\underline  {L}L using an AA force field (left) and its corresponding mapping into Martini CG (right). Underlined letters refer to \textit  {D}-amino acids.}}{49}{figure.caption.10}\protected@file@percent }
\newlabel{fig:AA2CG}{{3.5}{49}{Representation of the 3D structure of a CP with sequence \underline {L}L\underline {L}L\underline {L}L\underline {L}L using an AA force field (left) and its corresponding mapping into Martini CG (right). Underlined letters refer to \textit {D}-amino acids}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.3}Metadynamics}{49}{subsection.3.1.3}\protected@file@percent }
\newlabel{eq:metaD}{{3.14}{50}{Metadynamics}{equation.3.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Progressive evolution of a one-dimensional model potential \(V(x)\) by metadynamics bias. The thick black curve is the starting potential with two wells and a central barrier. Thin colored lines (from dark purple to yellow) represent the dynamic evolution of the sum of Gaussians along a trajectory that first explores the left well, then crosses the barrier, and finally visits the right well.}}{51}{figure.caption.11}\protected@file@percent }
\newlabel{fig:metad}{{3.6}{51}{Progressive evolution of a one-dimensional model potential \(V(x)\) by metadynamics bias. The thick black curve is the starting potential with two wells and a central barrier. Thin colored lines (from dark purple to yellow) represent the dynamic evolution of the sum of Gaussians along a trajectory that first explores the left well, then crosses the barrier, and finally visits the right well}{figure.caption.11}{}}
\newlabel{eq:wtmetaD}{{3.16}{51}{Metadynamics}{equation.3.16}{}}
