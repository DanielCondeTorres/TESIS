\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Scheme of a Multilayer Perceptron. The image illustrates the architecture of a MLP with one input layer (green) that has 3 neurons, two hidden layers (black) with 6 and 4 neurons respectively, and an output layer of one neuron. The image was generated using Matplotlib.}}{56}{figure.caption.14}\protected@file@percent }
\newlabel{fig:MLP}{{3.9}{56}{Scheme of a Multilayer Perceptron. The image illustrates the architecture of a MLP with one input layer (green) that has 3 neurons, two hidden layers (black) with 6 and 4 neurons respectively, and an output layer of one neuron. The image was generated using Matplotlib}{figure.caption.14}{}}
