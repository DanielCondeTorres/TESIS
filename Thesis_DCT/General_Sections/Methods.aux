\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Progressive evolution of a one-dimensional model potential \(V(x)\) by metadynamics bias. The thick black curve is the starting potential with two wells and a central barrier. Thin colored lines (from dark purple to yellow) represent the dynamic evolution of the sum of Gaussians along a trajectory that first explores the left well, then crosses the barrier, and finally visits the right well.}}{57}{figure.caption.10}\protected@file@percent }
\newlabel{fig:metad}{{3.5}{57}{Progressive evolution of a one-dimensional model potential \(V(x)\) by metadynamics bias. The thick black curve is the starting potential with two wells and a central barrier. Thin colored lines (from dark purple to yellow) represent the dynamic evolution of the sum of Gaussians along a trajectory that first explores the left well, then crosses the barrier, and finally visits the right well}{figure.caption.10}{}}
\newlabel{eq:wtmetaD}{{3.21}{57}{Metadynamics}{equation.3.21}{}}
