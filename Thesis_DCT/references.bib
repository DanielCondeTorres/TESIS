@Article{general_1,
AUTHOR = {Galdiero, Stefania and Falanga, Annarita and Cantisani, Marco and Vitiello, Mariateresa and Morelli, Giancarlo and Galdiero, Massimiliano},
TITLE = {Peptide-Lipid Interactions: Experiments and Applications},
JOURNAL = {International Journal of Molecular Sciences},
