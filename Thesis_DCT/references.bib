@article{afm_1,
 abstract = {Antimicrobial peptides are postulated to disrupt microbial phospholipid membranes. The prevailing molecular model is based on the formation of stable or transient pores although the direct observation of the fundamental processes is lacking. By combining rational peptide design with topographical (atomic force microscopy) and chemical (nanoscale secondary ion mass spectrometry) imaging on the same samples, we show that pores formed by antimicrobial peptides in supported lipid bilayers are not necessarily limited to a particular diameter, nor they are transient, but can expand laterally at the nano-to-micrometer scale to the point of complete membrane disintegration. The results offer a mechanistic basis for membrane poration as a generic physicochemical process of cooperative and continuous peptide recruitment in the available phospholipid matrix.},
 author = {Paulina D. Rakowska  and Haibo Jiang  and Santanu Ray  and Alice Pyne  and Baptiste Lamarre  and Matthew Carr  and Peter J. Judge  and Jascindra Ravi  and Ulla I. M. Gerling  and Beate Koksch  and Glenn J. Martyna  and Bart W. Hoogenboom  and Anthony Watts  and Jason Crain  and Chris R. M. Grovenor  and Maxim G. Ryadnov },
 doi = {10.1073/pnas.1222824110},
 eprint = {https://www.pnas.org/doi/pdf/10.1073/pnas.1222824110},
 journal = {Proceedings of the National Academy of Sciences},
 number = {22},
 pages = {8918-8923},
 title = {Nanoscale imaging reveals laterally expanding antimicrobial pores in lipid bilayers},
 url = {https://www.pnas.org/doi/abs/10.1073/pnas.1222824110},
 volume = {110},
 year = {2013}
}

@article{afm_2,
 abstract = {A number of peptides are known to bind lipid bilayer membranes and cause these natural barriers to leak in an uncontrolled manner. Though membrane permeabilizing peptides play critical roles in cellular activity and may have promising future applications in the therapeutic arena, significant questions remain about their mechanisms of action. The atomic force microscope (AFM) is a single molecule imaging tool capable of addressing lipid bilayers in near-native fluid conditions. The apparatus complements traditional assays by providing local topographic maps of bilayer remodeling induced by membrane permeabilizing peptides. The information garnered from the AFM includes direct visualization and statistical analyses of distinct bilayer remodeling modes such as highly localized pore-like voids in the bilayer and dispersed thinned membrane regions. Colocalization of distinct remodeling modes can be studied. Here we examine recent work in the field and outline methods used to achieve precise AFM image data. Experimental challenges and common pitfalls are discussed as well as techniques for unbiased analysis including the Hessian blob detection algorithm, bootstrapping, and the Bayesian information criterion. When coupled with robust statistical analyses, high precision AFM data is poised to advance understanding of an important family of peptides that cause poration of membrane bilayers.},
 author = {K.G. Schaefer and A.E. Pittman and F.N. Barrera and G.M. King},
 doi = {10.1016/j.ymeth.2020.10.014},
 issn = {1046-2023},
 journal = {Methods},
 keyword = {Pore forming, AFM, Scanning probe, Supported lipid bilayer, SLB},
 pages = {20-29},
 title = {Atomic force microscopy for quantitative understanding of peptide-induced lipid bilayer remodeling},
 url = {https://www.sciencedirect.com/science/article/pii/S1046202320302292},
 volume = {197},
 year = {2022}
}

